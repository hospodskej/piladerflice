<%
  all_recommendations = [
    { title: "Jasan", type: "Tvrdé palivové dřevo", price: "od 1 740 Kč", image: "eshop/jasan.png" },
    { title: "Bříza", type: "Tvrdé palivové dřevo", price: "---", image: "eshop/briza.png" },
    { title: "Habr", type: "Tvrdé palivové dřevo", price: "od 1 900 Kč", image: "eshop/habr.png" },
    { title: "Odkory na topení", type: "Tvrdé / Měkké", price: "od 800 Kč", image: "eshop/odkory.png" },
    { title: "Buk", type: "Tvrdé palivové dřevo", price: "od 1 900 Kč", image: "eshop/buk.png" },
  ]

  recommendations = all_recommendations.reject { |p| p[:title] == local_assigns[:current_product] }.take(4)
%>

<section class="recommendations-section">
  <h2 class="section-title text-center">Mohlo by vás také <span class="text-blue">zajímat:</span></h2>
  <div class="eshop-grid">
    <% recommendations.each do |product| %>
      <div class="product-card">
        <div class="product-image-wrapper-eshop">
          <%= image_tag product[:image], alt: product[:title], class: "product-img" %>
        </div>
        <div class="product-info-eshop">
          <h4 class="product-title"><%= product[:title] %></h4>
          <p class="product-type"><%= product[:type] %></p>
          <p class="product-stock">skladem</p>
          <p class="product-price"><%= product[:price] %></p>
          <%= link_to "Detail", "#", class: "btn-primary btn-detail" %>
        </div>
      </div>
    <% end %>
  </div>
</section>