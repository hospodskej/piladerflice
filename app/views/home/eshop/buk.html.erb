<%
  current_product = "Buk"

  @breadcrumb_items = [
    ["E-shop", "/eshop"],
    ["Palivové dřevo", "/eshop?category=palivove"],
    ["Buk", "#"]
  ]

  inventory_items = [
    { variant: "Sypané", length: "100 cm", amount: "5 PRM", price: "21 500 Kč", image: "eshop/container.png" },
    { variant: "Sypané", length: "100 cm", amount: "10 PRM", price: "17 863 Kč", image: "eshop/container.png" },
    { variant: "Sypané", length: "100 cm", amount: "15 PRM", price: "21 500 Kč", image: "eshop/container.png" },
    { variant: "Sypané", length: "100 cm", amount: "15 PRM", price: "21 500 Kč", image: "eshop/container.png" },
    { variant: "Sypané", length: "100 cm", amount: "15 PRM", price: "21 500 Kč", image: "eshop/container.png" },
    { variant: "Sypané", length: "100 cm", amount: "15 PRM", price: "21 500 Kč", image: "eshop/container.png" },
    { variant: "Sypané", length: "100 cm", amount: "15 PRM", price: "21 500 Kč", image: "eshop/container.png" },
    { variant: "Sypané", length: "100 cm", amount: "15 PRM", price: "21 500 Kč", image: "eshop/container.png" }
  ]
%>

<main class="product-page-main">
  <div class="product-container">

    <section class="product-intro-section">
      <div class="product-intro-image">
        <%= image_tag "eshop/buk.png", alt: "Buk palivové dřevo" %>
      </div>
      <div class="product-intro-details">
        <h1>Buk</h1>
        <p class="subtitle">Tvrdé palivové dřevo</p>
        <p class="description">
          Bukové dřevo s vysokou výhřevností a rovnoměrným hořením, ideální pro dlouhodobé vytápění.
          Výhřevnost cca 2100–2200 kWh/m³, hoří 2–3 hodiny.
        </p>
        <p class="drying-note">Doporučeno sušit 1–2 roky.</p>
        <p class="stock-status">Skladem</p>
      </div>
    </section>

    <section class="inventory-section">

      <div class="inventory-filter">
        <span class="filter-label">Typ ložení</span>
        <div class="filter-buttons">
          <button class="filter-btn active" data-target="all">Vše</button>
          <button class="filter-btn" data-target="kontejner">Kontejner</button>
          <button class="filter-btn" data-target="bedny">Bedny</button>
        </div>
      </div>

      <hr class="inventory-separator main-separator">

      <%
        kontejner_lengths = ["100 cm", "50 cm", "33 cm", "25 cm"]
        kontejner_rows = [
          { label: "5 m3", amount: "5 PRM", color: "text-red", price: "21 500 Kč" },
          { label: "10 m3", amount: "10 PRM", color: "text-green", price: "17 863 Kč" },
          { label: "15 m3", amount: "15 PRM", color: "text-yellow", price: "21 500 Kč" }
        ]

        bedny_items = [
          { length: "50 cm", amount: "1 PRM", price: "21 500 Kč", color: "text-pink" },
          { length: "33 cm", amount: "1 PRM", price: "17 863 Kč", color: "text-pink" },
          { length: "25 cm", amount: "1 PRM", price: "21 500 Kč", color: "text-pink" }
        ]
      %>

      <div id="section-kontejner" class="inventory-group">
        <h2 class="section-title"><span class="text-blue">Volně ložené</span> palivové dřevo</h2>

        <div class="matrix-grid">
          <div class="matrix-cell empty"></div>
          <% kontejner_lengths.each do |len| %>
            <div class="matrix-cell col-header"><%= len %></div>
          <% end %>

          <% kontejner_rows.each do |row| %>
            <div class="matrix-cell row-header"><span><%= row[:label] %></span></div>
            <% kontejner_lengths.each do |len| %>
              <div class="matrix-cell">
                <div class="inventory-card">
                  <%= image_tag "eshop/container.png", alt: "Kontejner", class: "inventory-img" %>
                  <div class="inventory-specs">
                    <div class="spec-labels">
                      <span>Varianta</span>
                      <span>Délka</span>
                      <span>Množství</span>
                    </div>
                    <div class="spec-values">
                      <span class="spec-value">Sypané</span>
                      <span class="spec-value"><%= len %></span>
                      <span class="spec-value <%= row[:color] %>"><%= row[:amount] %></span>
                    </div>
                  </div>
                  <p class="inventory-price"><%= row[:price] %></p>
                  <%= button_to "Do košíku", "#", class: "btn-primary btn-cart" %>
                </div>
              </div>
            <% end %>
          <% end %>
        </div>
      </div>

      <hr class="inventory-separator mid-separator">

      <div id="section-bedny" class="inventory-group">
        <h2 class="section-title"><span class="text-blue">Skládané</span> palivové dřevo v bednách</h2>

        <div class="matrix-grid-bedny">
          <div class="matrix-cell empty"></div>
          <% bedny_items.each do |item| %>
            <div class="matrix-cell">
              <div class="inventory-card">
                <%= image_tag "eshop/bedna.png", alt: "Bedna", class: "inventory-img" %>
                <div class="inventory-specs">
                  <div class="spec-labels">
                    <span>Varianta</span>
                    <span>Délka</span>
                    <span>Množství</span>
                  </div>
                  <div class="spec-values">
                    <span class="spec-value">Skládané</span>
                    <span class="spec-value"><%= item[:length] %></span>
                    <span class="spec-value <%= item[:color] %>"><%= item[:amount] %></span>
                  </div>
                </div>
                <p class="inventory-price"><%= item[:price] %></p>
                <%= button_to "Do košíku", "#", class: "btn-primary btn-cart" %>
              </div>
            </div>
          <% end %>
        </div>
      </div>

    </section>

    <script>
        document.addEventListener("DOMContentLoaded", () => {
            const buttons = document.querySelectorAll(".filter-btn");
            const sectionKontejner = document.getElementById("section-kontejner");
            const sectionBedny = document.getElementById("section-bedny");
            const midSeparator = document.querySelector(".mid-separator");

            buttons.forEach(btn => {
                btn.addEventListener("click", (e) => {
                    e.preventDefault();

                    buttons.forEach(b => b.classList.remove("active"));
                    btn.classList.add("active");

                    const target = btn.dataset.target;

                    if (target === "all") {
                        sectionKontejner.style.display = "block";
                        sectionBedny.style.display = "block";
                        midSeparator.style.display = "block";
                    } else if (target === "kontejner") {
                        sectionKontejner.style.display = "block";
                        sectionBedny.style.display = "none";
                        midSeparator.style.display = "none";
                    } else if (target === "bedny") {
                        sectionKontejner.style.display = "none";
                        sectionBedny.style.display = "block";
                        midSeparator.style.display = "none";
                    }
                });
            });
        });
    </script>

    <%= render "shared/recommendations", current_product: current_product %>

  </div>

  <%= render "shared/custom_demand" %>
</main>