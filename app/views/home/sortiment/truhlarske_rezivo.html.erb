<% page_meta :truhlarske_rezivo %>
<%# TODO: Vyměnit obrázek truhlářského řeziva - the page (fosny3, fosny1) and the
    "Truhlářské řezivo" card in Sortiment (fosny1, Admin > the sortiment
    products / db/seeds.rb) show photos of fošny, i.e. construction lumber.
    Replace them with real photos of joinery lumber. %>
<%
  products = [
               {
                 title: t("sortiment.truhlarske_rezivo.fosny.title"),
                 descriptions: [t("sortiment.truhlarske_rezivo.fosny.desc_1")],
                 images: ["sortiment/fosny3.webp", "sortiment/fosny1.webp"],
                 eshop_link: "/eshop/fosny"
               }
  ]
%>

<main class="main">
  <% products.each_with_index do |product, index| %>
    <%= render partial: "shared/product_row", locals: {
      title: product[:title],
      descriptions: product[:descriptions],
      images: product[:images],
      eshop_link: product[:eshop_link],
      reverse: index.odd?
    } %>
  <% end %>
  <%= render "shared/wood_types" %>
  <%= render "shared/jak_objednat" %>
</main>
