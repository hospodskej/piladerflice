<%
  products = [
    {
      title: t("sortiment.vyrobni_zbytky.odkory.title"),
      descriptions: [t("sortiment.vyrobni_zbytky.odkory.desc_1")],
      images: ["sortiment/odrezky1.png", "sortiment/odrezky2.png"],
      eshop_link: "/eshop/odkory"
    },
    {
      title: t("sortiment.vyrobni_zbytky.stepka.title"),
      descriptions: [t("sortiment.vyrobni_zbytky.stepka.desc_1")],
      images: ["sortiment/stepka1.png", "sortiment/stepka2.png"],
      eshop_link: "/eshop/stepka"
    },
    {
      title: t("sortiment.vyrobni_zbytky.piliny.title"),
      descriptions: [t("sortiment.vyrobni_zbytky.piliny.desc_1")],
      images: ["sortiment/piliny1.png", "sortiment/piliny2.png"],
      eshop_link: "/eshop/piliny"
    }
  ]
%>

<main class="main">
  <% products.each_with_index do |product, index| %>
    <%= render partial: "shared/product_row", locals: {
      title: product[:title],
      descriptions: product[:descriptions],
      images: product[:images],
      eshop_link: product[:eshop_link],
      reverse: index.odd?
    } %>
  <% end %>
  <%= render "shared/wood_types" %>
  <%= render "shared/jak_objednat" %>
</main>
