<%
  products = [
    {
      title: t("sortiment.okrasne_kamenivo.title"),
      descriptions: [
        t("sortiment.okrasne_kamenivo.desc_1"),
        t("sortiment.okrasne_kamenivo.desc_2"),
        t("sortiment.okrasne_kamenivo.desc_3"),
        t("sortiment.okrasne_kamenivo.desc_4")
      ],
      images: ["sortiment/kamenivo1.png"],
      eshop_link: "/eshop/okrasne_kamenivo"
    }
  ]
%>

<main class="main">
  <% products.each_with_index do |product, index| %>
    <%= render partial: "shared/product_row", locals: {
      title: product[:title],
      descriptions: product[:descriptions],
      images: product[:images],
      eshop_link: product[:eshop_link],
      reverse: index.odd?
    } %>
  <% end %>
  <%= render "shared/jak_objednat" %>
</main>
