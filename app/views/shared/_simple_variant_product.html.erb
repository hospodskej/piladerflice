<%
  # Shared template for the "simple variant grid" detail pages (odkory,
  # piliny, stepka, okrasne_kamenivo) - a title/description intro followed
  # by a flat grid of purchasable variants (no length/container matrix).
  # `key` is the canonical product identifier (eshop.products.<key>),
  # `i18n_key` points at the matching eshop.<i18n_key> block that holds this
  # page's breadcrumb/description/item_label text.
  #
  # Each item's `spec2_spec` follows the same { "type" => "key"|"raw",
  # "value" => ... } shape used for cart specs (see
  # shared/_add_to_cart_form), so the wood-species/variant/fraction text
  # stays language-neutral all the way into the cart.
  title = t("eshop.products.#{key}.title")

  @breadcrumb_items = [
    [t("breadcrumbs.eshop"), "/eshop"],
    [t("eshop.#{i18n_key}.breadcrumb_category"), "/eshop?category=#{category_param}"],
    [title, "#"]
  ]

  item_label_key = "eshop.#{i18n_key}.item_label"
  item_label = t(item_label_key)
  resolve_spec = ->(spec) { spec["type"] == "key" ? t(spec["value"]) : spec["value"] }
%>

<main class="product-page-main">
  <div class="product-container">

    <section class="product-intro-section">
      <div class="product-intro-image">
        <%= image_tag "eshop/#{key}.png", alt: title %>
      </div>
      <div class="product-intro-details">
        <h1><%= title %></h1>
        <p class="description">
          <%= t("eshop.#{i18n_key}.description") %>
        </p>
      </div>
    </section>

    <section class="inventory-section">

      <hr class="inventory-separator main-separator">

      <div id="section-kontejner" class="inventory-group">
        <h2 class="section-title"><%= t("common.available_variants_html") %></h2>

        <div class="<%= grid_class %>">
          <% items.each do |item| %>
            <% unit_price_czk = item[:price].gsub(/\D/, "").to_i %>
            <div class="inventory-card">
              <%= image_tag "eshop/container.png", alt: t("common.container"), class: "inventory-img" %>

              <div class="inventory-specs">
                <div class="spec-labels">
                  <span><%= t("common.spec_description") %></span>
                  <span><%= t(spec2_label_key) %></span>
                </div>
                <div class="spec-values">
                  <span class="spec-value"><%= item_label %></span>
                  <span class="spec-value"><%= resolve_spec.call(item[:spec2_spec]) %></span>
                </div>
              </div>

              <p class="inventory-price"><%= ExchangeRateService.display_amount(unit_price_czk) %></p>

              <p class="spec-value <%= item[:in_stock] ? 'text-green' : 'text-red' %>" style="margin-bottom: 12px; font-size: 0.95rem;">
                <%= item[:in_stock] ? t("common.in_stock") : t("common.out_of_stock") %>
              </p>

              <% if item[:in_stock] %>
                <%= render "shared/add_to_cart_form",
                    product_key: key,
                    image: "eshop/#{key}.png",
                    unit_price_czk: unit_price_czk,
                    specs: [
                      { "type" => "key", "value" => item_label_key },
                      item[:spec2_spec]
                    ] %>
              <% else %>
                <%= button_to t("common.out_of_stock"), "#", class: "btn-primary btn-cart", disabled: true, style: "background-color: #9CA3AF; color: #FFFFFF; border: none; cursor: not-allowed;" %>
              <% end %>
            </div>
          <% end %>
        </div>
      </div>

    </section>

    <%= render "shared/recommendations", current_product: key %>

  </div>

  <%= render "shared/custom_demand" %>
</main>
