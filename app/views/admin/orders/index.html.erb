<h1 class="admin-page-title">Objednávky</h1>

<% if @orders.any? %>
  <table class="admin-table">
    <thead>
      <tr>
        <th>Č.</th>
        <th>Zákazník</th>
        <th>E-mail</th>
        <th>Celkem</th>
        <th>Doprava</th>
        <th>Platba</th>
        <th>Datum</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% @orders.each do |order| %>
        <tr>
          <td><%= link_to "##{order.id}", admin_order_path(order) %></td>
          <td><%= order.full_name %></td>
          <td><%= order.email %></td>
          <td><%= ExchangeRateService.display_amount(order.total_czk, locale: :cs) %></td>
          <td><%= order.shipping_method == "pickup" ? "Osobní odběr" : "Doručení" %></td>
          <td><%= order.payment_method == "bank_transfer" ? "Převod" : "Hotově" %></td>
          <td><%= order.created_at.strftime("%d.%m.%Y %H:%M") %></td>
          <td><%= button_to "Smazat", admin_order_path(order), method: :delete, class: "admin-danger-btn", form: { data: { turbo_confirm: "Opravdu smazat tuto objednávku?" } } %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <p>Zatím žádné objednávky.</p>
<% end %>
