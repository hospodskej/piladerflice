<div class="admin-toolbar">
  <h1 class="admin-page-title">Formulář poptávky</h1>
</div>
<p class="admin-page-subtitle">Možnosti v rozbalovacích seznamech na kalkulačce v kontaktním formuláři. První možnost v seznamu je přednastavená (preset).</p>

<% InquiryFormOption::CATEGORIES.each do |category| %>
  <h2 class="admin-section-title"><%= InquiryFormOption::CATEGORY_LABELS[category] %></h2>

  <% InquiryFormOption::DROPDOWN_FIELDS[category].each do |field| %>
    <div class="admin-box admin-option-group" id="<%= category %>-<%= field %>">
      <h2><%= InquiryFormOption::FIELD_LABELS[field] %></h2>

      <table class="admin-table">
        <thead>
          <tr>
            <th>Pořadí</th>
            <th>Hodnota (CZ)</th>
            <th>Hodnota (DE)</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% (@options.dig(category, field) || []).each do |option| %>
            <tr>
              <td class="admin-option-move">
                <%= button_to "↑", move_up_admin_inquiry_form_option_path(option), method: :patch, class: "admin-move-btn" %>
                <%= button_to "↓", move_down_admin_inquiry_form_option_path(option), method: :patch, class: "admin-move-btn" %>
              </td>
              <td colspan="2">
                <%= form_with model: option, url: admin_inquiry_form_option_path(option), method: :patch, class: "admin-option-form" do |f| %>
                  <%= f.text_field :value, value: option.value %>
                  <%= f.text_field :value_de, value: option.value_de %>
                  <%= f.submit "Uložit", class: "btn-outline-dark" %>
                <% end %>
              </td>
              <td>
                <%= button_to "Smazat", admin_inquiry_form_option_path(option), method: :delete, class: "admin-danger-btn", data: { turbo_confirm: "Opravdu smazat tuto možnost?" } %>
              </td>
            </tr>
          <% end %>
          <tr>
            <td colspan="4">
              <%= form_with model: InquiryFormOption.new, url: admin_inquiry_form_options_path, class: "admin-option-form" do |f| %>
                <%= f.hidden_field :category, value: category %>
                <%= f.hidden_field :field, value: field %>
                <%= f.text_field :value, placeholder: "Nová možnost (CZ)" %>
                <%= f.text_field :value_de, placeholder: "Nová možnost (DE)" %>
                <%= f.submit "+ Přidat možnost", class: "btn-primary" %>
              <% end %>
            </td>
          </tr>
        </tbody>
      </table>
    </div>
  <% end %>
<% end %>
