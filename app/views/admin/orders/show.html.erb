<%= link_to "← Zpět na objednávky", admin_orders_path, class: "admin-back-link" %>

<div class="admin-toolbar">
  <div>
    <h1 class="admin-page-title">Objednávka #<%= @order.id %></h1>
    <p class="admin-page-subtitle"><%= @order.created_at.strftime("%d.%m.%Y %H:%M") %></p>
  </div>
  <%= button_to "Smazat objednávku", admin_order_path(@order), method: :delete, class: "admin-danger-btn", form: { data: { turbo_confirm: "Opravdu smazat tuto objednávku?" } } %>
</div>

<div class="admin-detail-grid">
  <div class="admin-box">
    <h2>Zákazník</h2>
    <p><%= @order.full_name %><br>
      <%= mail_to @order.email %><br>
      <%= @order.phone %></p>
    <p>Newsletter: <%= @order.newsletter_opt_in? ? "Ano" : "Ne" %></p>
  </div>

  <div class="admin-box">
    <h2>Fakturační adresa</h2>
    <p>
      <%= @order.billing_street %><br>
      <%= @order.billing_zip %> <%= @order.billing_city %><br>
      <%= @order.billing_country_name(locale: :cs) %>
    </p>
    <% if @order.company_purchase? %>
      <p><strong><%= @order.company_name %></strong><br>
        IČO: <%= @order.company_ico %><br>
        DIČ: <%= @order.company_dic %></p>
    <% end %>
  </div>

  <% if @order.delivery_address_different? %>
    <div class="admin-box">
      <h2>Doručovací adresa</h2>
      <p>
        <%= @order.delivery_street %><br>
        <%= @order.delivery_zip %> <%= @order.delivery_city %><br>
        <%= @order.delivery_country_name(locale: :cs) %>
      </p>
    </div>
  <% end %>

  <div class="admin-box">
    <h2>Doprava a platba</h2>
    <p>
      <%= @order.shipping_method == "pickup" ? "Osobní odběr na adrese skladu" : "Doručení na adresu" %><br>
      <%= @order.payment_method == "bank_transfer" ? "Bankovním převodem - proforma" : "Hotově při vyzvednutí" %>
    </p>
    <p>Jazyk zákazníka: <%= @order.locale == "de" ? "němčina" : "čeština" %></p>
  </div>
</div>

<div class="admin-box">
  <h2>Obsah objednávky</h2>
  <table class="admin-table">
    <thead>
      <tr>
        <th>Položka</th>
        <th>Množství</th>
        <th>Jedn. cena</th>
        <th>Celkem</th>
      </tr>
    </thead>
    <tbody>
      <% @items.each do |item| %>
        <tr>
          <td><%= cart_line_description(item) %></td>
          <td><%= item.quantity %></td>
          <td><%= @order.format_amount(item.unit_price) %></td>
          <td><%= @order.format_amount(item.line_total) %></td>
        </tr>
      <% end %>
    </tbody>
  </table>

  <div class="admin-order-totals">
    <% if @order.delivery_quoted? || @order.discounted? %>
      <p>Zboží: <%= @order.display(:subtotal) %></p>
    <% end %>
    <% if @order.discounted? %>
      <p><%= t("order_mailer.discount", code: @order.discount_code, locale: :cs) %>: −<%= @order.display(:discount) %></p>
    <% end %>
    <% if @order.delivery_quoted? %>
      <p><%= t("order_mailer.delivery", km: @order.delivery_distance_km, locale: :cs) %>: <%= @order.display(:delivery) %></p>
    <% elsif @order.shipping_method == "address" %>
      <p>Doprava: vzdálenost se nepodařilo spočítat, cena dopravy není v celkové ceně.</p>
    <% end %>
    <p>Bez DPH: <%= @order.display(:total_excl_vat) %></p>
    <% @order.vat_by_rate_in_currency.each do |rate, amount| %>
      <p>DPH <%= rate %> % (<%= @order.vat_country_name(locale: :cs) %>): <%= @order.format_in_currency(amount) %></p>
    <% end %>
    <% if @order.vat_by_rate.size > 1 %>
      <p>DPH celkem: <%= @order.display(:vat) %></p>
    <% end %>
    <p><strong>Celkem k úhradě: <%= @order.display(:total) %></strong></p>
  </div>
</div>
