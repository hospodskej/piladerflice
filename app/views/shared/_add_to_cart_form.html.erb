<% show_qty = local_assigns.fetch(:show_qty, true) %>
<%= form_with url: cart_items_path, method: :post, class: "add-to-cart-form" do %>
  <%= hidden_field_tag :catalog_variant_id, catalog_variant.id %>
  <div class="qty-cart-row">
    <% if show_qty %>
      <div class="qty-stepper">
        <button type="button" class="qty-btn qty-minus" aria-label="<%= t('common.qty_decrease') %>">&minus;</button>
        <%= number_field_tag :quantity, 1, min: 1, class: "qty-value", readonly: true %>
        <button type="button" class="qty-btn qty-plus" aria-label="<%= t('common.qty_increase') %>">+</button>
      </div>
    <% else %>
      <%= hidden_field_tag :quantity, 1 %>
    <% end %>
    <%= button_tag type: "submit", name: nil, class: "btn-primary btn-cart", title: t("common.add_to_cart"), aria: { label: t("common.add_to_cart") } do %>
      <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="9" cy="21" r="1"></circle>
        <circle cx="20" cy="21" r="1"></circle>
        <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>      </svg>
    <% end %>
  </div>
<% end %>
