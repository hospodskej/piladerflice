<%
  # `key` is the canonical (language-independent) product identifier used to
  # look up the translated title/type/price/image in the locale files, so
  # switching to German doesn't depend on matching Czech text anywhere.
  all_recommendations = [
    { key: "jasan", image: "eshop/jasan.png", url: "eshop/jasan" },
    { key: "briza", image: "eshop/briza.png", url: "eshop/briza" },
    { key: "habr", image: "eshop/habr.png", url: "eshop/habr" },
    { key: "odkory", image: "eshop/odkory.png", url: "eshop/odkory" },
    { key: "buk", image: "eshop/buk.png", url: "eshop/buk" },
  ]

  recommendations = all_recommendations.reject { |p| p[:key] == local_assigns[:current_product] }.take(4)
%>

<section class="recommendations-section">
  <h2 class="section-title text-center"><%= t("shared.recommendations.title_html") %></h2>
  <div class="eshop-grid">
    <% recommendations.each do |product| %>
      <% title = t("eshop.products.#{product[:key]}.title") %>
      <div class="product-card">
        <div class="product-image-wrapper-eshop">
          <%= image_tag product[:image], alt: title, class: "product-img" %>
        </div>
        <div class="product-info-eshop">
          <h4 class="product-title"><%= title %></h4>
          <p class="product-type"><%= t("eshop.products.#{product[:key]}.type") %></p>
          <p class="product-stock"><%= t("common.stock") %></p>
          <p class="product-price"><%= t("eshop.products.#{product[:key]}.price") %></p>
          <%= link_to t("common.detail"), "#", class: "btn-primary btn-detail" %>
        </div>
      </div>
    <% end %>
  </div>
</section>
