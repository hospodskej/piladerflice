<%# The VAT lines under a total: "DPH 21 %", or one line per rate and the sum
    when the goods have more than one (e.g. firewood 13 % and lumber 20 % to Austria).
    by_rate: { rate in % => VAT in Kč } (VatBreakdown#by_rate, Order#vat_by_rate) %>
<% by_rate.each do |rate, amount| %>
  <div class="cart-total-row cart-total-excl-vat">
    <span><%= t("cart.vat_at_rate", rate: rate) %></span>
    <span><%= cart_price(amount) %></span>
  </div>
<% end %>
<% if by_rate.size > 1 %>
  <div class="cart-total-row cart-total-excl-vat">
    <span><%= t("cart.total_vat") %></span>
    <span><%= cart_price(by_rate.values.sum) %></span>
  </div>
<% end %>
