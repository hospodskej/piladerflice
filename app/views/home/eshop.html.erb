<%
  valid_categories = %w[palivove rezivo zbytky kamenivo]
  category = valid_categories.include?(params[:category]) ? params[:category] : "palivove"

  base_products = CatalogProduct.active.where(category: category)

  products =
    case params[:wood]
    when "tvrde" then base_products.where(hardness: "hard")
    when "mekke" then base_products.where(hardness: "soft")
    else base_products
    end.to_a

  sort_order =
    if params[:sort] == "nejprodavanejsi"
      %w[buk dub smrk tramy fosny late piliny odkory stepka okrasne_kamenivo]
    else
      %w[smrk dub buk late tramy fosny stepka odkory piliny okrasne_kamenivo]
    end

  products.sort_by! { |p| sort_order.index(p.key) || 999 }
%>

<main class="eshop-main main">
  <turbo-frame id="eshop_content" data-turbo-action="advance">
    <div class="eshop-container">

      <section class="eshop-filters">
        <h3><%= t("eshop.index.filters_title") %></h3>
        <div class="filter-group">
          <%= link_to t("eshop.index.cat_palivove"), "/eshop?category=palivove&sort=#{params[:sort]}", class: "btn-filter #{'active' if params[:category].blank? || params[:category] == 'palivove'}" %>
          <%= link_to t("eshop.index.cat_rezivo"), "/eshop?category=rezivo&sort=#{params[:sort]}", class: "btn-filter #{'active' if params[:category] == 'rezivo'}" %>
          <%= link_to t("eshop.index.cat_zbytky"), "/eshop?category=zbytky&sort=#{params[:sort]}", class: "btn-filter #{'active' if params[:category] == 'zbytky'}" %>
          <%= link_to t("eshop.index.cat_kamenivo"), "/eshop?category=kamenivo&sort=#{params[:sort]}", class: "btn-filter #{'active' if params[:category] == 'kamenivo'}" %>
        </div>

        <% if params[:category].blank? || params[:category] == 'palivove' %>
          <h3 class="mt-40"><%= t("eshop.index.wood_type_title") %></h3>
          <div class="filter-group">
            <%= link_to t("eshop.index.wood_all"), "/eshop?category=#{params[:category]}&wood=vse&sort=#{params[:sort]}", class: "btn-filter btn-filter-sm #{'active' if params[:wood].blank? || params[:wood] == 'vse'}" %>
            <%= link_to t("eshop.index.wood_hard"), "/eshop?category=#{params[:category]}&wood=tvrde&sort=#{params[:sort]}", class: "btn-filter btn-filter-sm #{'active' if params[:wood] == 'tvrde'}" %>
            <%= link_to t("eshop.index.wood_soft"), "/eshop?category=#{params[:category]}&wood=mekke&sort=#{params[:sort]}", class: "btn-filter btn-filter-sm #{'active' if params[:wood] == 'mekke'}" %>
          </div>
        <% end %>
      </section>

      <section class="eshop-sorting">
        <div class="sorting-tabs">
          <%= link_to t("eshop.index.sort_recommended"), "/eshop?category=#{params[:category]}&wood=#{params[:wood]}&sort=doporucujeme", class: "btn-sort #{'active' if params[:sort].blank? || params[:sort] == 'doporucujeme'}" %>
          <%= link_to t("eshop.index.sort_bestsellers"), "/eshop?category=#{params[:category]}&wood=#{params[:wood]}&sort=nejprodavanejsi", class: "btn-sort #{'active' if params[:sort] == 'nejprodavanejsi'}" %>
        </div>
        <hr class="sorting-divider">
      </section>

      <section class="eshop-grid">
        <% products.each_with_index do |product, index| %>
          <div class="product-card">
            <%= link_to "/eshop/#{product.key}", class: "product-image-wrapper-eshop", data: { turbo: false } do %>
              <% if index < 3 %>
                <span class="product-badge"><%= index + 1 %>.</span>
              <% end %>
              <%= image_tag_if_attached product.image, alt: product.title_i18n, class: "product-img" %>
            <% end %>

            <div class="product-info-eshop">
              <h4 class="product-title"><%= product.title_i18n %></h4>
              <p class="product-type"><%= product.type_label_i18n %></p>
              <p class="product-stock"><%= t("common.stock") %></p>
              <p class="product-price">
                <% if product.starting_price_czk %>
                  <%= t("common.price_from") %> <%= ExchangeRateService.display_amount(product.starting_price_czk) %>
                <% else %>
                  ---
                <% end %>
              </p>
              <%= link_to t("common.detail"), "/eshop/#{product.key}", class: "btn-primary btn-detail", data: { turbo: false } %>
            </div>
          </div>
        <% end %>
      </section>

    </div>
  </turbo-frame>

  <%= render "shared/custom_demand" %>
</main>
