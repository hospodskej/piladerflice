<%
  lengths = ["3 000 mm", "4 000 mm", "5 000 mm"]
  rows = [
    { label: "100/100", value: "100/100 mm", color: "text-black", price: "8 500 Kč" },
    { label: "100/120", value: "100/120 mm", color: "text-black", price: "8 500 Kč" },
    { label: "100/140", value: "100/140 mm", color: "text-black", price: "8 500 Kč" },
    { label: "100/160", value: "100/160 mm", color: "text-black", price: "8 500 Kč" }
  ]
%>
<%= render "shared/lumber_product",
    key: "tramy",
    grid_class: "matrix-grid-3",
    lengths: lengths,
    rows: rows,
    spec_labels: ["common.spec_variant", "common.spec_length", "common.spec_amount"],
    first_value_spec: { "type" => "key", "value" => "common.loose_variant" } %>
