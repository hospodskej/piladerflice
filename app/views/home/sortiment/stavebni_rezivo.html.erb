<%
  products = [
    {
      title: t("sortiment.stavebni_rezivo.tramy.title"),
      descriptions: [t("sortiment.stavebni_rezivo.tramy.desc_1"), t("sortiment.stavebni_rezivo.tramy.desc_2")],
      images: ["sortiment/tramy1.webp", "sortiment/tramy2.webp"],
      eshop_link: "/eshop/tramy"
    },
    {
      title: t("sortiment.stavebni_rezivo.prkna.title"),
      descriptions: [t("sortiment.stavebni_rezivo.prkna.desc_1"), t("sortiment.stavebni_rezivo.prkna.desc_2")],
      images: ["sortiment/prkna1.webp", "sortiment/prkna2.webp"],
      eshop_link: "/eshop/prkna"
    },
    {
      title: t("sortiment.stavebni_rezivo.late.title"),
      descriptions: [t("sortiment.stavebni_rezivo.late.desc_1"), t("sortiment.stavebni_rezivo.late.desc_2")],
      images: ["sortiment/late1.webp", "sortiment/late2.webp"],
      eshop_link: "/eshop/late"
    },
    {
      title: t("sortiment.stavebni_rezivo.fosny.title"),
      descriptions: [t("sortiment.stavebni_rezivo.fosny.desc_1"), t("sortiment.stavebni_rezivo.fosny.desc_2")],
      images: ["sortiment/fosny1.webp", "sortiment/fosny2.webp"],
      eshop_link: "/eshop/fosny"
    }
  ]
%>

<main class="main">
  <% products.each_with_index do |product, index| %>
    <%= render partial: "shared/product_row", locals: {
      title: product[:title],
      descriptions: product[:descriptions],
      images: product[:images],
      eshop_link: product[:eshop_link],
      reverse: index.odd?
    } %>
  <% end %>
  <%= render "shared/wood_types" %>
  <%= render "shared/jak_objednat" %>
</main>
