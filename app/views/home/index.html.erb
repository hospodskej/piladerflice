<main class="main">
  <section class="hero-section">
    <div class="left-part">
      <div>
        <h1><span class="text-accent"><%= t("home.index.hero_title_accent") %></span><br><%= t("home.index.hero_title_rest") %></h1>
        <p><%= t("home.index.hero_text") %></p>
      </div>
      <div class="domu-buttons">
        <%= link_to t("home.index.btn_eshop"), "/eshop/", class: "btn-eshop" %>
        <%= link_to t("home.index.btn_vyroba"), "/kontakt#kalkulace", class: "btn-vyroba" %>
      </div>

      <div class="reviews">
        <%= image_tag "google-review.png", alt: "Google recenze", class: "google-logo", width: "48", height: "48" %>

        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 370 48" width="280" height="48">
          <defs>
            <g id="star">
              <path fill="#FABB05" d="M24 34.54l12.36 7.46-3.28-14.06 10.92-9.46-14.38-1.22L24 4 18.38 17.26 4 18.48l10.92 9.46-3.28 14.06z"/>
            </g>
          </defs>

          <use href="#star" x="0" y="0" />
          <use href="#star" x="60" y="0" />
          <use href="#star" x="120" y="0" />
          <use href="#star" x="180" y="0" />
          <use href="#star" x="240" y="0" />
        </svg>

        <div class="review-text">
          <strong>4.6 </strong><span class="review-text-accent"><%= t("home.index.reviews_count") %></span>
        </div>
      </div>

      <div class="features">
        <% features = [
          { name: t("home.index.features.doprava"), img: "doprava.png" },
          { name: t("home.index.features.vyroba"), img: "vyroba.png"},
          { name: t("home.index.features.sortiment"), img: "sortiment.png"},
          { name: t("home.index.features.vyrobce"), img: "vyrobce.png"},
          { name: t("home.index.features.garance"), img: "garance.png"},
          { name: t("home.index.features.ceny"), img: "wallet.png"}
        ] %>

        <% features.each do |feature| %>
          <div class="feature-card">
            <div class="feature-item">
              <%= image_tag "features/#{feature[:img]}", alt: feature[:name] %>
            </div>
            <span class="feature-text"><%= feature[:name].html_safe %></span>
          </div>
        <% end %>
      </div>

    </div>

    <div class="right-part">
      <% if @hero_promo %>
        <div class="akcni-product-card">
          <div class="badge"><%= t("home.index.promo_badge") %></div>
          <%= image_tag @hero_promo.image, alt: t("home.index.promo_alt"), class: "hero-image" %>
          <div class="product-info">
            <div class="product-subinfo">
              <h2 class="product-title"><%= @hero_promo.title_i18n %></h2>
              <ul class="product-features">
                <li><%= @hero_promo.feature_1_i18n %></li>
                <li><%= @hero_promo.feature_2_i18n %></li>
                <li><%= @hero_promo.feature_3_i18n %></li>
              </ul>
            </div>
            <div class="akcni-product-price">
              <span class="akcni-nabidka-price"><%= @hero_promo.price_i18n %></span>
              <%= link_to t("home.index.promo_cta"), @hero_promo.link, class: "akce-btn-eshop" %>
            </div>
          </div>
        </div>
      <% end %>

      <div class="top-categories-section">
        <h2 class="top-categories-title"><span class="brand-blue"><%= t("home.index.top_categories_title_accent") %></span> <%= t("home.index.top_categories_title_rest") %></h2>

        <% categories = [
          { name: t("home.index.categories.palivove_drevo"), img: "top-palivove-drevo.png", url: "/sortiment/palivove-drevo" },
          { name: t("home.index.categories.stavebni_drevo"), img: "top-stavebni-drevo.png", url: "/sortiment/stavebni-rezivo" },
          { name: t("home.index.categories.vyrobni_zbytky"), img: "top-vyrobni-zbytky.png", url: "/sortiment/vyrobni-zbytky" },
        ] %>

        <div class="top-categories-grid">
          <% categories.each do |category| %>
            <div class="top-categories-item">
              <%= image_tag "top-kategorie/#{category[:img]}", alt: category[:name], class: "top-categories-image" %>
              <%= link_to category[:name], category[:url], class: "top-categories-button" %>
            </div>
          <% end %>
        </div>
      </div>

    </div>
  </section>
  <section class="let-zkusenosti-section">
    <div class="let-zkusenosti-banner">
      <h2><%= t("home.index.zkusenosti_banner") %></h2>
    </div>
  </section>
  <section class="akcni-nabidka-section">
    <div class="akcni-nabidka-left">
      <div class="akcni-nabidka-header">
        <h1><%= t("home.index.akcni_nabidka_title_rest") %> <span style="color: #2C8FFF"><%= t("home.index.akcni_nabidka_title_accent") %></span></h1>
        <div class="akcni-nabidka">
          <h4><%= t("home.index.akcni_nabidka_lead_html") %></h4>
          <h4><%= t("home.index.akcni_nabidka_text_html") %></h4>
        </div>
        <div class="akcni-nabidka-cenik">
          <%= link_to t("common.cenik"), "/kontakt#cenik", class: "akcni-nabidka-button" %>
        </div>
      </div>
    </div>
    <div class="akcni-nabidka-right">
      <div class="akcni-nabidka-decoration">
        <div class="product-image-wrapper">
          <div class="akcni-badge"><%= t("home.index.akcni_badge") %></div>
          <%= image_tag "akcni-nabidka.png", alt: t("home.index.akcni_image_alt"), class: "akcni-nabidka-image" %>
        </div>
      </div>
    </div>
  </section>
  <section class="nejprodavanejsi-produkty-section">
    <h1><span style="color: #2C8FFF"><%= t("home.index.nejprodavanejsi_title_accent") %></span>    <%= t("home.index.nejprodavanejsi_title_rest") %></h1>
    <div class="nejprodavanejsi-produkty-grid">
      <%
        nejprodavanejsi = [
          {
            title: t("home.index.bestsellers.akat.title"),
            desc: t("home.index.bestsellers.akat.desc"),
            price: t("home.index.bestsellers.akat.price"),
            img: "akat.png",
            path: eshop_akat_path
          },
          {
            title: t("home.index.bestsellers.tramy.title"),
            desc: t("home.index.bestsellers.tramy.desc"),
            price: t("home.index.bestsellers.tramy.price"),
            img: "tramy.png",
            path: eshop_tramy_path
          },
          {
            title: t("home.index.bestsellers.dub.title"),
            desc: t("home.index.bestsellers.dub.desc"),
            price: t("home.index.bestsellers.dub.price"),
            img: "akat2.png",
            path: eshop_dub_path
          }
        ]
      %>

      <% nejprodavanejsi.each do |product| %>
        <div class="nejprodavanejsi-produkty-card">
          <%= image_tag "nejprodavanejsi-produkty/#{product[:img]}", alt: product[:title], class: "nejprodavanejsi-produkty-image" %>

          <div class="nejprodavanejsi-produkty-details">
            <span class="nejprodavanejsi-produkty-title"><%= product[:title] %></span>
            <span class="nejprodavanejsi-produkty-desc"><strong><%= product[:desc] %></strong></span>
            <span class="nejprodavanejsi-produkty-stock"><%= t("common.stock") %></span>
            <span class="nejprodavanejsi-produkty-price"><strong><%= product[:price] %></strong></span>

            <%= link_to t("home.index.btn_prohlednout"), product[:path], class:"btn-prohlednout" %>
          </div>
        </div>
      <% end %>
    </div>

  </section>
  <section class="nabidka-section">
    <div class="nabidka-header">
      <h2><%= t("home.index.nabidka_title_rest") %> <span style="color: #2C8FFF"><%= t("home.index.nabidka_title_accent") %></span></h2>
      <div class="nabidka-text">
        <p><%= t("home.index.nabidka_text_1_html") %></p>
        <p><%= t("home.index.nabidka_text_2_html") %></p>
      </div>
    </div>

    <div class="nabidka-grid">
      <% @produkty.each do |item| %>
        <div class="nabidka-card">
          <%= link_to item.link, class: "nabidka-image-link" do %>
            <%= image_tag item.image, alt: item.title_i18n, class: "nabidka-image" %>
          <% end %>
          <%= link_to item.title_i18n, item.link, class: "nabidka-btn" %>
        </div>
      <% end %>
    </div>
  </section>
  <section class="sluzby-section">
    <h2><%= t("home.index.sluzby_title_rest") %> <span style="color: #2C8FFF"><%= t("home.index.sluzby_title_accent") %></span></h2>

    <div class="accordion">
      <% @sluzby.each do |sluzba| %>
        <div class="accordion-item">
          <button class="accordion-header">
            <span class="accordion-title"><%= sluzba.title_i18n %></span>
            <span class="accordion-icon">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="6 9 12 15 18 9"></polyline>
              </svg>
            </span>
          </button>

          <div class="accordion-content-wrapper">
            <div class="accordion-content">
              <div class="accordion-body">
                <p><%= sluzba.content_i18n.html_safe %></p>

                <% if sluzba.button_text.present? && sluzba.button_path.present? %>
                  <%= link_to sluzba.button_text_i18n, sluzba.button_path, class: "btn-cenik" %>
                <% end %>
              </div>
            </div>
          </div>

        </div>
      <% end %>
    </div>
  </section>
  <section class="dorucujeme-section">
    <div class="dorucujeme-text">
      <h2> <%= t("home.index.dorucujeme_title_rest") %> <span style="color: #2C8FFF"><%= t("home.index.dorucujeme_title_accent") %></span></h2>

      <p><%= t("home.index.dorucujeme_text_1") %></p>
      <p><%= t("home.index.dorucujeme_text_2") %></p>
      <%= link_to t("common.cenik"), "/kontakt#cenik", class: "btn-primary" %>
    </div>

    <div class="dorucujeme-map">
      <%= image_tag "mapa-doruceni.png", alt: t("home.index.dorucujeme_map_alt") %>
    </div>
  </section>
  <section class="co-je-noveho-section">
    <div class="co-je-noveho-gallery">
      <%= image_tag "co-je-noveho-pic1.png", alt: t("home.index.co_je_noveho_pic1_alt"), class: "co-je-noveho-img co-je-noveho-img-main" %>
      <%= image_tag "co-je-noveho-pic2.png", alt: t("home.index.co_je_noveho_pic2_alt"), class: "co-je-noveho-img" %>
      <%= image_tag "co-je-noveho-pic3.png", alt: t("home.index.co_je_noveho_pic3_alt"), class: "co-je-noveho-img" %>
    </div>

    <div class="co-je-noveho-text">
      <h2><%= t("home.index.co_je_noveho_title_rest") %> <span style="color: #2C8FFF"><%= t("home.index.co_je_noveho_title_accent") %></span></h2>
      <h3><%= t("home.index.co_je_noveho_subtitle") %></h3>
      <p><%= t("home.index.co_je_noveho_text") %></p>
      <%= link_to t("common.cenik"), "/kontakt#cenik", class: "btn-primary" %>
    </div>
  </section>
  <section class="how-to-order-section">
    <%= render "shared/jak_objednat" %>
  </section>
  <section class="co-by-vas-mohlo-zajimat">
    <h2><%= t("home.index.zajimat_title_rest") %> <span style="color: #2C8FFF"><%= t("home.index.zajimat_title_accent") %></span></h2>

    <div class="carousel-wrapper" id="zajimatCarousel">
      <button class="carousel-btn prev-btn" id="carouselPrev" aria-label="<%= t('common.previous') %>">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"></polyline></svg>
      </button>

      <div class="carousel-container">
        <% @zajimavosti.each_with_index do |slide, index| %>
          <div class="carousel-slide <%= 'active' if index == 0 %>">
            <%= image_tag slide.image, class: "carousel-bg-img", alt: slide.title_i18n %>
            <div class="carousel-overlay"></div>

            <div class="carousel-content">
              <h3><%= slide.title_i18n %></h3>
              <div class="carousel-text">
                <p><%= slide.content_i18n.html_safe %></p>
              </div>
            </div>
          </div>
        <% end %>
      </div>

      <button class="carousel-btn next-btn" id="carouselNext" aria-label="<%= t('common.next') %>">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
      </button>
    </div>

    <div class="carousel-dots">
      <% @zajimavosti.each_with_index do |slide, index| %>
        <button class="carousel-dot <%= 'active' if index == 0 %>" aria-label="<%= "#{t('common.slide')} #{index + 1}" %>"></button>
      <% end %>
    </div>

  </section>
  <section class="faq-section">
    <h2 class="faq-main-title"><%= t("home.index.faq_title_rest") %> <span style="color: #2C8FFF"><%= t("home.index.faq_title_accent") %></span></h2>

    <% [
         { key: "palivove", count: 4 },
         { key: "stavebni", count: 4 },
         { key: "doprava", count: 4 }
       ].each do |category| %>
      <h3 class="faq-category-title"><%= t("home.index.faq_cat_#{category[:key]}") %></h3>

      <div class="faq-grid">
        <% (1..category[:count]).each do |i| %>
          <div class="accordion-item faq-item">
            <button class="accordion-header">
              <span class="accordion-title"><%= t("home.index.faq_#{category[:key]}_q#{i}") %></span>
              <span class="faq-icon"></span>
            </button>

            <div class="accordion-content-wrapper">
              <div class="accordion-content">
                <div class="accordion-body">
                  <p><%= t("home.index.faq_#{category[:key]}_a#{i}") %></p>
                </div>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    <% end %>

    <div class="faq-cta">
      <div class="faq-cta-left">
        <span class="faq-cta-icon">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M20 15.5c-1.25 0-2.45-.2-3.57-.57a1.02 1.02 0 0 0-1.02.24l-2.2 2.2a15.045 15.045 0 0 1-6.59-6.59l2.2-2.21a.96.96 0 0 0 .25-1A11.36 11.36 0 0 1 8.5 4c0-.55-.45-1-1-1H4c-.55 0-1 .45-1 1 0 9.39 7.61 17 17 17 .55 0 1-.45 1-1v-3.5c0-.55-.45-1-1-1z"/></svg>
        </span>
        <span><%= t("home.index.faq_cta_text") %></span>
      </div>
      <%= link_to t("home.index.faq_cta_button"), "/kontakt", class: "btn-primary" %>
    </div>
  </section>
  <section class="o-sobe-section">
    <div class="o-sobe-card">
      <div class="o-sobe-image-wrapper">
        <%= image_tag "o-sobe/nakladak.png", alt: t("home.index.o_sobe_image_alt"), class: "o-sobe-image" %>
      </div>

      <div class="o-sobe-text">
        <h2><%= t("home.index.o_sobe_title_rest") %> <span style="color: #2C8FFF"><%= t("home.index.o_sobe_title_accent") %></span></h2>
        <p><%= t("home.index.o_sobe_p1_html") %></p>
        <p><%= t("home.index.o_sobe_p2_html") %></p>
        <p><%= t("home.index.o_sobe_p3_html") %></p>
        <p><%= t("home.index.o_sobe_p4") %></p>
        <p><%= t("home.index.o_sobe_p5_html") %></p>
        <%= link_to t("home.index.o_sobe_cta"), "/kontakt#kalkulace", class: "btn-primary" %>
      </div>
    </div>
  </section>
  <section class="google-reviews-section">
    <h2><%= t("home.index.google_reviews_title_rest") %> <span style="color: #2C8FFF"><%= t("home.index.google_reviews_title_accent") %></span></h2>

    <div class="google-reviews-header">
      <div class="google-reviews-rating">
        <%= image_tag "google-review.png", alt: "Google", class: "google-reviews-logo" %>
        <div>
          <div class="google-reviews-score">4.6 <span class="google-reviews-stars">★★★★★</span></div>
          <div class="google-reviews-count"><%= t("home.index.google_reviews_count") %></div>
        </div>
      </div>

      <div class="google-reviews-divider"></div>

      <div class="google-reviews-verified">
        <span class="google-reviews-check">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><polyline points="8 12 11 15 16 9"></polyline></svg>
        </span>
        <div>
          <div class="google-reviews-verified-title"><%= t("home.index.google_reviews_verified_title") %></div>
          <div class="google-reviews-verified-sub"><%= t("home.index.google_reviews_verified_sub") %></div>
        </div>
      </div>
    </div>

    <div class="google-reviews-carousel">
      <button class="carousel-btn prev-btn" id="googleReviewsPrev" aria-label="<%= t('common.previous') %>">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"></polyline></svg>
      </button>

      <div class="google-reviews-viewport">
        <div class="google-reviews-grid" id="googleReviewsTrack">
        <% @google_reviews.each do |review| %>
          <div class="google-review-card">
            <div class="google-review-card-header">
              <div class="google-review-avatar" style="background-color: <%= review.avatar_color %>;"><%= review.initial %></div>
              <div>
                <div class="google-review-name"><%= review.name %></div>
                <div class="google-review-source">
                  <%= image_tag "google-review.png", alt: "Google", class: "google-review-source-icon" %>
                  <%= t("home.index.google_review_source") %>
                </div>
              </div>
            </div>
            <div class="google-review-meta">
              <span class="google-review-stars"><%= "★" * review.stars %></span>
              <span class="google-review-time"><%= review.time_ago_i18n %></span>
            </div>
            <p class="google-review-text"><%= review.text %></p>
            <div class="google-review-like">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M1 21h4V9H1v12zm22-11c0-1.1-.9-2-2-2h-6.31l.95-4.57.03-.32c0-.41-.17-.79-.44-1.06L14.17 1 7.59 7.59C7.22 7.95 7 8.45 7 9v10c0 1.1.9 2 2 2h9c.83 0 1.54-.5 1.84-1.22l3.02-7.05c.09-.23.14-.47.14-.73v-2z"/></svg>
              <%= t("home.index.google_review_like") %>
            </div>
          </div>
        <% end %>
        </div>
      </div>

      <button class="carousel-btn next-btn" id="googleReviewsNext" aria-label="<%= t('common.next') %>">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
      </button>
    </div>
  </section>
</main>
