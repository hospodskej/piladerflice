<%= link_to "← Zpět na poptávky", admin_inquiries_path, class: "admin-back-link" %>

<h1 class="admin-page-title">Poptávka #<%= @inquiry.id %></h1>
<p class="admin-page-subtitle">
  <%= @inquiry.created_at.strftime("%d.%m.%Y %H:%M") %> · jazyk formuláře: <%= @inquiry.locale == "de" ? "němčina" : "čeština" %>
</p>

<div class="admin-detail-grid">
  <div class="admin-box">
    <h2>Kontakt</h2>
    <p><%= @inquiry.full_name %><br>
      <%= mail_to @inquiry.email %><br>
      <%= @inquiry.phone %></p>
    <% if @inquiry.full_address.present? %>
      <p><%= @inquiry.full_address %></p>
    <% end %>
  </div>
</div>

<div class="admin-box">
  <% @inquiry.items_by_category.each do |category, rows| %>
    <% fields = InquiryFormOption::ROW_FIELDS.fetch(category) %>
    <h2 class="<%= "admin-inquiry-next-category" unless category == @inquiry.categories.first %>">Požadované položky – <%= InquiryFormOption::CATEGORY_LABELS.fetch(category, category) %></h2>
    <table class="admin-table">
      <thead>
        <tr>
          <% fields.each do |field| %>
            <th><%= InquiryFormOption::FIELD_LABELS[field] %></th>
          <% end %>
        </tr>
      </thead>
      <tbody>
        <% rows.each do |item| %>
          <tr>
            <% fields.each do |field| %>
              <td><%= item[field] %></td>
            <% end %>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% end %>

  <% if @inquiry.notes.present? %>
    <h2 style="margin-top: 20px;">Poznámka</h2>
    <p style="white-space: pre-wrap;"><%= @inquiry.notes %></p>
  <% end %>
</div>
