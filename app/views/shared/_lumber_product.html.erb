<%
  product = CatalogProduct.find_by!(key: key)
  title = product.title_i18n

  @breadcrumb_items = [
    [t("breadcrumbs.eshop"), "/eshop"],
    [t("eshop.#{key}.breadcrumb_category"), "/eshop?category=rezivo"],
    [title, "#"]
  ]

  variants = product.catalog_variants.to_a
  lengths = variants.map(&:length_label).uniq
  dimensions = variants.map(&:variant_label).uniq
%>

<main class="product-page-main main">
  <div class="product-container">

    <section class="product-intro-section">
      <div class="product-intro-image">
        <%= image_tag product.image, alt: title %>
      </div>
      <div class="product-intro-details">
        <h1><%= title %></h1>
        <p class="description">
          <%= product.description_i18n %>
        </p>
        <p class="stock-status"><%= t("common.in_stock") %></p>
      </div>
    </section>

    <section class="inventory-section">

      <hr class="inventory-separator main-separator">

      <div id="section-kontejner" class="inventory-group">
        <h2 class="section-title"><%= t("eshop.#{key}.loose_heading_html") %></h2>

        <div class="matrix-grid-3">
          <div class="matrix-cell empty"></div>
          <% lengths.each do |len| %>
            <div class="matrix-cell col-header"><%= len %></div>
          <% end %>

          <% dimensions.each do |dim| %>
            <% dim_variant = variants.find { |v| v.variant_label == dim } %>
            <div class="matrix-cell row-header"><span><%= dim_variant.variant_label_i18n %></span></div>
            <% lengths.each do |len| %>
              <% variant = variants.find { |v| v.variant_label == dim && v.length_label == len } %>
              <div class="matrix-cell">
                <% if variant %>
                  <div class="inventory-card">
                    <%= image_tag "eshop/container.png", alt: t("common.container"), class: "inventory-img" %>
                    <div class="inventory-specs">
                      <div class="spec-labels">
                        <span><%= t("common.spec_variant") %></span>
                        <span><%= t("common.spec_length") %></span>
                        <span><%= t("common.spec_dimension") %></span>
                      </div>
                      <div class="spec-values">
                        <span class="spec-value"><%= product.type_label_i18n %></span>
                        <span class="spec-value"><%= len %></span>
                        <span class="spec-value"><%= variant.variant_label_i18n %></span>
                      </div>
                    </div>
                    <p class="inventory-price"><%= ExchangeRateService.display_amount(variant.price_czk) %></p>
                    <% if variant.in_stock? %>
                      <%= render "shared/add_to_cart_form", catalog_variant: variant %>
                    <% else %>
                      <%= button_to t("common.out_of_stock"), "#", class: "btn-primary btn-cart", disabled: true, style: "background-color: #9CA3AF; color: #FFFFFF; border: none; cursor: not-allowed;" %>
                    <% end %>
                  </div>
                <% end %>
              </div>
            <% end %>
          <% end %>
        </div>
      </div>

    </section>

    <%= render "shared/recommendations", current_product: key %>

  </div>

  <%= render "shared/custom_demand" %>
</main>
