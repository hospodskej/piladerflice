<%
  # `key` is the canonical (language-independent) product identifier used to
  # look up the translated title/type/price in the locale files, and
  # `hardness` is used for the wood-type filter below - neither depends on
  # the display language, so switching to German never breaks filtering,
  # sorting, or badge numbering.
  firewood_products = [
    { key: "smrk", hardness: "soft", image: "eshop/smrk.png", url: "eshop/smrk" },
    { key: "dub", hardness: "hard", image: "eshop/dub.png", url: "eshop/dub" },
    { key: "buk", hardness: "hard", image: "eshop/buk.png", url: "eshop/buk" },
    { key: "akat", hardness: "hard", image: "eshop/akat.png", url: "eshop/akat" },
    { key: "jasan", hardness: "hard", image: "eshop/jasan.png", url: "/eshop/jasan" },
    { key: "briza", hardness: "hard", image: "eshop/briza.png", url: "/eshop/briza" },
    { key: "habr", hardness: "hard", image: "eshop/habr.png", url: "/eshop/habr" }
  ]

  lumber_products = [
    { key: "late", image: "eshop/late.png", url: "/eshop/late" },
    { key: "tramy", image: "eshop/tramy.png", url: "/eshop/tramy" },
    { key: "fosny", image: "eshop/fosny.png", url: "/eshop/fosny" },
    { key: "prkna", image: "eshop/prkna.png", url: "/eshop/prkna" },
  ]

  residuals_products = [
    { key: "stepka", image: "eshop/stepka.png", url: "/eshop/stepka" },
    { key: "odkory", image: "eshop/odkory.png", url: "/eshop/odkory" },
    { key: "piliny", image: "eshop/piliny.png", url: "/eshop/piliny" },
  ]

  gravel_products = [
    { key: "okrasne_kamenivo", image: "eshop/kamenivo.png", url: "/eshop/okrasne_kamenivo" },
  ]

  if params[:category] == "rezivo"
    base_products = lumber_products
  elsif params[:category] == "zbytky"
    base_products = residuals_products
  elsif params[:category] == "kamenivo"
    base_products = gravel_products
  else
    base_products = firewood_products
  end

  if params[:wood] == "tvrde"
    products = base_products.select { |p| p[:hardness] == "hard" }
  elsif params[:wood] == "mekke"
    products = base_products.select { |p| p[:hardness] == "soft" }
  else
    products = base_products.dup
  end

  if params[:sort] == "nejprodavanejsi"
    sort_order = ["buk", "dub", "smrk", "tramy", "fosny", "late", "piliny", "odkory", "stepka", "okrasne_kamenivo"]
  else
    sort_order = ["smrk", "dub", "buk", "late", "tramy", "fosny", "stepka", "odkory", "piliny", "okrasne_kamenivo"]
  end

  products.sort_by! { |p| sort_order.index(p[:key]) || 999 }
%>

<main class="eshop-main">
  <turbo-frame id="eshop_content" data-turbo-action="advance">
    <div class="eshop-container">

      <section class="eshop-filters">
        <h3><%= t("eshop.index.filters_title") %></h3>
        <div class="filter-group">
          <%= link_to t("eshop.index.cat_palivove"), "/eshop?category=palivove&sort=#{params[:sort]}", class: "btn-filter #{'active' if params[:category].blank? || params[:category] == 'palivove'}" %>
          <%= link_to t("eshop.index.cat_rezivo"), "/eshop?category=rezivo&sort=#{params[:sort]}", class: "btn-filter #{'active' if params[:category] == 'rezivo'}" %>
          <%= link_to t("eshop.index.cat_zbytky"), "/eshop?category=zbytky&sort=#{params[:sort]}", class: "btn-filter #{'active' if params[:category] == 'zbytky'}" %>
          <%= link_to t("eshop.index.cat_kamenivo"), "/eshop?category=kamenivo&sort=#{params[:sort]}", class: "btn-filter #{'active' if params[:category] == 'kamenivo'}" %>
        </div>

        <% if params[:category].blank? || params[:category] == 'palivove' %>
          <h3 class="mt-40"><%= t("eshop.index.wood_type_title") %></h3>
          <div class="filter-group">
            <%= link_to t("eshop.index.wood_all"), "/eshop?category=#{params[:category]}&wood=vse&sort=#{params[:sort]}", class: "btn-filter btn-filter-sm #{'active' if params[:wood].blank? || params[:wood] == 'vse'}" %>
            <%= link_to t("eshop.index.wood_hard"), "/eshop?category=#{params[:category]}&wood=tvrde&sort=#{params[:sort]}", class: "btn-filter btn-filter-sm #{'active' if params[:wood] == 'tvrde'}" %>
            <%= link_to t("eshop.index.wood_soft"), "/eshop?category=#{params[:category]}&wood=mekke&sort=#{params[:sort]}", class: "btn-filter btn-filter-sm #{'active' if params[:wood] == 'mekke'}" %>
          </div>
        <% end %>
      </section>

      <section class="eshop-sorting">
        <div class="sorting-tabs">
          <%= link_to t("eshop.index.sort_recommended"), "/eshop?category=#{params[:category]}&wood=#{params[:wood]}&sort=doporucujeme", class: "btn-sort #{'active' if params[:sort].blank? || params[:sort] == 'doporucujeme'}" %>
          <%= link_to t("eshop.index.sort_bestsellers"), "/eshop?category=#{params[:category]}&wood=#{params[:wood]}&sort=nejprodavanejsi", class: "btn-sort #{'active' if params[:sort] == 'nejprodavanejsi'}" %>
        </div>
        <hr class="sorting-divider">
      </section>

      <section class="eshop-grid">
        <% products.each_with_index do |product, index| %>
          <% title = t("eshop.products.#{product[:key]}.title") %>
          <div class="product-card">
            <div class="product-image-wrapper-eshop">
              <% if index < 3 %>
                <span class="product-badge"><%= index + 1 %>.</span>
              <% end %>
              <%= image_tag product[:image], alt: title, class: "product-img" %>
            </div>

            <div class="product-info-eshop">
              <h4 class="product-title"><%= title %></h4>
              <p class="product-type"><%= t("eshop.products.#{product[:key]}.type") %></p>
              <p class="product-stock"><%= t("common.stock") %></p>
              <p class="product-price"><%= eshop_catalog_price(product[:key]) %></p>
              <%= link_to t("common.detail"), product[:url] || "#", class: "btn-primary btn-detail", data: { turbo: false } %>
            </div>
          </div>
        <% end %>
      </section>

    </div>
  </turbo-frame>

  <%= render "shared/custom_demand" %>
</main>
