# Settings for a development machine: copy to .env and fill in. .env is
# git-ignored and read only in development; a server uses
# /etc/pila-derflice.env instead (see deploy/pila-derflice.env.example).

# The admin account `cargo run -- admin` creates (or resets).
ADMIN_EMAIL=
ADMIN_PASSWORD=

# openrouteservice key for the delivery price; never commit it.
ORS_API_KEY=

# Without SMTP_USERNAME, e-mails are only written to the log.
SMTP_USERNAME=
SMTP_PASSWORD=
