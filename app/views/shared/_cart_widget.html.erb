<% cart_count = current_cart.total_quantity %>
<div id="cart-widget" class="cart-dropdown">
  <button type="button" class="btn-pill cart-btn" aria-haspopup="true" aria-expanded="false"
          aria-label="<%= cart_count.positive? ? t("cart.aria_label_count", count: cart_count) : t("cart.aria_label") %>">
    <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <circle cx="9" cy="21" r="1"></circle>
      <circle cx="20" cy="21" r="1"></circle>
      <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
    </svg>
    <% if cart_count.positive? %>
      <span class="cart-count" aria-hidden="true"><%= cart_count > 99 ? "99+" : cart_count %></span>
    <% end %>
  </button>

  <div class="cart-dropdown-content">
    <% if current_cart.empty? %>
      <p class="cart-empty"><%= t("cart.empty") %></p>
    <% else %>
      <ul class="cart-items-list">
        <% current_cart.items.each do |item| %>
          <li class="cart-item">
            <%= image_tag item.image, alt: cart_line_description(item), class: "cart-item-img" if item.image %>
            <div class="cart-item-details">
              <span class="cart-item-desc"><%= cart_line_description(item) %></span>
            </div>
            <span class="cart-item-price"><%= cart_price(item.line_total_czk) %></span>
          </li>
        <% end %>
      </ul>

      <div class="cart-totals">
        <%= render "carts/totals", compact: true %>
      </div>

      <%= link_to t("cart.view_cart"), cart_path, class: "btn-primary full-width cart-dropdown-view-cart" %>
    <% end %>
  </div>
</div>
