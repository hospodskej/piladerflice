# /etc/pila-derflice.env (readable by root and the pila user only:
#   sudo chown root:pila /etc/pila-derflice.env && sudo chmod 640 /etc/pila-derflice.env)
# Never commit the filled-in file.

APP_ENV=production
APP_ROOT=/opt/pila-derflice/current
HOST=127.0.0.1
PORT=4000
RUST_LOG=info

# The data: the database and the uploaded images (Active Storage's folder).
DATABASE_URL=sqlite:/var/lib/pila-derflice/production.sqlite3
STORAGE_DIR=/var/lib/pila-derflice/storage

# At least 64 characters: openssl rand -hex 64
SECRET_KEY_BASE=

# Delivery price by distance (openrouteservice.org); empty = priced individually.
ORS_API_KEY=

# E-mail. Port 465 = TLS from the start, 587 = STARTTLS.
SMTP_ADDRESS=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM_ADDRESS=objednavky@piladerflice.cz
ORDER_NOTIFICATION_EMAIL=
INQUIRY_NOTIFICATION_EMAIL=
