<%
  product = CatalogProduct.find_by!(key: key)
  title = product.title_i18n

  @breadcrumb_items = [
    [t("breadcrumbs.eshop"), "/eshop"],
    [t("eshop.#{key}.breadcrumb_category"), "/eshop?category=rezivo"],
    [title, "#"]
  ]

  variants = product.catalog_variants.ordered.to_a
%>

<main class="product-page-main main">
  <div class="product-container">

    <section class="product-intro-section">
      <div class="product-intro-image">
        <%= image_tag product.image, alt: title %>
      </div>
      <div class="product-intro-details">
        <h1><%= title %></h1>
        <p class="description">
          <%= product.description_i18n %>
        </p>
        <p class="stock-status"><%= t("common.in_stock") %></p>
      </div>
    </section>

    <section class="inventory-section">

      <hr class="inventory-separator main-separator">

      <h2 class="section-title"><%= t("eshop.#{key}.loose_heading_html") %></h2>

      <div class="simple-grid-3">
        <% variants.each do |variant| %>
          <div class="inventory-card">
            <%= image_tag product.image, alt: title, class: "inventory-img" %>
            <div class="inventory-specs">
              <div class="spec-labels">
                <% if variant.grade.present? %><span><%= t("common.spec_grade") %></span><% end %>
                <span><%= t("common.spec_length") %></span>
                <% if variant.width_mm.present? %><span><%= t("common.spec_width") %></span><% end %>
                <% if variant.height_mm.present? %><span><%= t("common.spec_height") %></span><% end %>
              </div>
              <div class="spec-values">
                <% if variant.grade.present? %><span class="spec-value"><%= variant.grade_i18n %></span><% end %>
                <span class="spec-value"><%= variant.length_label %></span>
                <% if variant.width_mm.present? %><span class="spec-value"><%= variant.width_mm %> mm</span><% end %>
                <% if variant.height_mm.present? %><span class="spec-value"><%= variant.height_mm %> mm</span><% end %>
              </div>
            </div>
            <p class="inventory-price"><%= ExchangeRateService.display_amount(variant.price_czk) %> <%= t("common.price_per_m3_html") %></p>
            <% if variant.in_stock? %>
              <%= render "shared/add_to_cart_form", catalog_variant: variant %>
            <% else %>
              <%= button_to t("common.out_of_stock"), "#", class: "btn-primary btn-cart", disabled: true, style: "background-color: #9CA3AF; color: #FFFFFF; border: none; cursor: not-allowed;" %>
            <% end %>
          </div>
        <% end %>
      </div>

    </section>

    <%= render "shared/recommendations", current_product: key %>

  </div>

  <%= render "shared/custom_demand" %>
</main>
