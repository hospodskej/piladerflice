<%
  current_product = "Okrasné kamenivo"

  @breadcrumb_items = [
    ["E-shop", "/eshop"],
    ["Okrasné kamenivo", "/eshop?category=kamenivo"],
    ["Okrasné kamenivo", "#"]
  ]

  kamenivo_items = [
    { fraction: "32/64 mm", stock: "skladem", stock_color: "text-green", in_stock: true, price: "20 Kč" },
    { fraction: "64/120 mm", stock: "skladem", stock_color: "text-green", in_stock: true, price: "30 Kč" },
    { fraction: "16/32 mm", stock: "skladem", stock_color: "text-green", in_stock: true, price: "1 Kč" }
  ]
%>

<main class="product-page-main">
  <div class="product-container">

    <section class="product-intro-section">
      <div class="product-intro-image">
        <%= image_tag "eshop/kamenivo.png", alt: "Okrasné kamenivo" %>
      </div>
      <div class="product-intro-details">
        <h1>Okrasné kamenivo</h1>
        <p class="description">
          Přírodní okrasné kamenivo pro úpravu zahrad, obsypy ploch a dekorativní účely. Dostupné ve třech frakcích.
        </p>
      </div>
    </section>

    <section class="inventory-section">

      <hr class="inventory-separator main-separator">

      <div id="section-kontejner" class="inventory-group">
        <h2 class="section-title"><span class="text-blue">Dostupné</span> varianty</h2>

        <div class="simple-grid-3">
          <% kamenivo_items.each do |item| %>
            <div class="inventory-card">
              <%= image_tag "eshop/container.png", alt: "Kontejner kamenivo", class: "inventory-img" %>

              <div class="inventory-specs">
                <div class="spec-labels">
                  <span>Popis</span>
                  <span>Frakce</span>
                </div>
                <div class="spec-values">
                  <span class="spec-value">Kamenivo</span>
                  <span class="spec-value"><%= item[:fraction] %></span>
                </div>
              </div>

              <p class="inventory-price"><%= item[:price] %></p>

              <p class="spec-value <%= item[:stock_color] %>" style="margin-bottom: 12px; font-size: 0.95rem;">
                <%= item[:stock] %>
              </p>

              <% if item[:in_stock] %>
                <%= button_to "Do košíku", "#", class: "btn-primary btn-cart" %>
              <% else %>
                <%= button_to "Není skladem", "#", class: "btn-primary btn-cart", disabled: true, style: "background-color: #9CA3AF; color: #FFFFFF; border: none; cursor: not-allowed;" %>
              <% end %>
            </div>
          <% end %>
        </div>
      </div>

    </section>

    <%= render "shared/recommendations", current_product: current_product %>

  </div>

  <%= render "shared/custom_demand" %>
</main>