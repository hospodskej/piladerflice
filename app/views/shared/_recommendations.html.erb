<%
  # `key` is the canonical (language-independent) product identifier -
  # product data itself now comes from the database (CatalogProduct/
  # CatalogVariant), so switching to German doesn't depend on matching
  # Czech text anywhere, and an admin can add/remove/reprice products
  # without a developer touching this list.
  recommendation_keys = %w[jasan briza habr odkory buk]
  products = CatalogProduct.active.where(key: recommendation_keys - [local_assigns[:current_product]]).index_by(&:key)
  recommendations = recommendation_keys.filter_map { |key| products[key] }.take(4)
%>

<section class="recommendations-section">
  <h2 class="section-title text-center"><%= t("shared.recommendations.title_html") %></h2>
  <div class="eshop-grid">
    <% recommendations.each do |product| %>
      <div class="product-card">
        <div class="product-image-wrapper-eshop">
          <%= image_tag product.image, alt: product.title_i18n, class: "product-img" %>
        </div>
        <div class="product-info-eshop">
          <h4 class="product-title"><%= product.title_i18n %></h4>
          <p class="product-type"><%= product.type_label_i18n %></p>
          <p class="product-stock"><%= t("common.stock") %></p>
          <p class="product-price">
            <% if product.starting_price_czk %>
              <%= t("common.price_from") %> <%= ExchangeRateService.display_amount(product.starting_price_czk) %>
            <% else %>
              ---
            <% end %>
          </p>
          <%= link_to t("common.detail"), "/eshop/#{product.key}", class: "btn-primary btn-detail", data: { turbo: false } %>
        </div>
      </div>
    <% end %>
  </div>
</section>
