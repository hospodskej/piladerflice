<section class="wood-types-section">
  <h2 class="wood-types-title"><%= t("shared.wood_types.title_html") %></h2>
  <div class="wood-types-layout">

    <div class="wood-category-box">
      <h3><%= t("shared.wood_types.soft_title") %></h3>
      <div class="wood-items-grid">
        <div class="wood-item">
          <%= image_tag "sortiment/palivove-drevo/smrk.png", class: "wood-texture", alt: t("shared.wood_types.soft_items.smrk") %>
          <span><%= t("shared.wood_types.soft_items.smrk") %></span>
        </div>
        <div class="wood-item">
          <%= image_tag "sortiment/palivove-drevo/borovice.png", class: "wood-texture", alt: t("shared.wood_types.soft_items.borovice") %>
          <span><%= t("shared.wood_types.soft_items.borovice") %></span>
        </div>
        <div class="wood-item">
          <%= image_tag "sortiment/palivove-drevo/modrin.png", class: "wood-texture", alt: t("shared.wood_types.soft_items.modrin") %>
          <span><%= t("shared.wood_types.soft_items.modrin") %></span>
        </div>
      </div>
    </div>

    <div class="wood-category-box">
      <h3><%= t("shared.wood_types.hard_title") %></h3>
      <div class="wood-items-grid">
        <div class="wood-item">
          <%= image_tag "sortiment/palivove-drevo/buk.png", class: "wood-texture", alt: t("shared.wood_types.hard_items.buk") %>
          <span><%= t("shared.wood_types.hard_items.buk") %></span>
        </div>
        <div class="wood-item">
          <%= image_tag "sortiment/palivove-drevo/habr.png", class: "wood-texture", alt: t("shared.wood_types.hard_items.habr") %>
          <span><%= t("shared.wood_types.hard_items.habr") %></span>
        </div>
        <div class="wood-item">
          <%= image_tag "sortiment/palivove-drevo/dub.png", class: "wood-texture", alt: t("shared.wood_types.hard_items.dub") %>
          <span><%= t("shared.wood_types.hard_items.dub") %></span>
        </div>
        <div class="wood-item">
          <%= image_tag "sortiment/palivove-drevo/akat.png", class: "wood-texture", alt: t("shared.wood_types.hard_items.akat") %>
          <span><%= t("shared.wood_types.hard_items.akat") %></span>
        </div>
        <div class="wood-item">
          <%= image_tag "sortiment/palivove-drevo/jasan.png", class: "wood-texture", alt: t("shared.wood_types.hard_items.jasan") %>
          <span><%= t("shared.wood_types.hard_items.jasan") %></span>
        </div>
      </div>
    </div>

  </div>
</section>
