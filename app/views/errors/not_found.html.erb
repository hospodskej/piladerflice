<% page_meta :not_found, title: t("not_found.title") %>
<% content_for :head do %>
  <meta name="robots" content="noindex">
<% end %>

<main class="main">
  <section class="not-found">
    <%# The shrugging mascot: "we couldn't find it". %>
    <%= image_tag "mascot/shrugging.webp", alt: t("not_found.alt"), class: "not-found-mascot", width: 320, height: 232, loading: "eager" %>
    <p class="not-found-code">404</p>
    <h1><%= t("not_found.heading") %></h1>
    <p class="not-found-text"><%= t("not_found.text") %></p>
    <%= link_to t("not_found.home"), root_path, class: "btn-primary" %>
    <nav class="not-found-links">
      <%= link_to t("not_found.eshop"), eshop_path %>
      <%= link_to t("not_found.sortiment"), sortiment_path %>
      <%= link_to t("not_found.kontakt"), kontakt_path %>
    </nav>
  </section>
</main>
