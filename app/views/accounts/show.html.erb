<main class="main">
  <section class="auth-section">
    <div class="account-page">
      <div class="auth-box">
        <h1 class="auth-box-title"><%= t("auth.account_title") %></h1>
        <div class="auth-box-body">
          <p class="account-email"><%= current_user.email_address %></p>

          <% if current_user.admin? %>
            <%= link_to t("auth.go_to_admin"), admin_root_path, class: "btn-primary auth-submit" %>
          <% end %>

          <%= button_to t("auth.logout"), logout_path, method: :delete, class: "btn-outline-dark auth-logout-btn" %>
        </div>
      </div>

      <div class="auth-box">
        <h2 class="auth-box-title"><%= t("auth.order_history_title") %></h2>
        <div class="auth-box-body">
          <% if @orders.any? %>
            <ul class="order-history-list">
              <% @orders.each do |order| %>
                <li class="order-history-item">
                  <div class="order-history-info">
                    <span class="order-history-number"><%= t("auth.order_number") %> <%= order.id %></span>
                    <span class="order-history-date"><%= order.created_at.strftime("%d.%m.%Y") %></span>
                    <span class="order-history-total"><%= t("auth.order_total") %>: <%= cart_price(order.total_czk) %></span>
                  </div>
                  <%= button_to t("auth.reorder_button"), reorder_order_path(order), method: :post, class: "btn-outline-dark order-history-reorder-btn" %>
                </li>
              <% end %>
            </ul>
          <% else %>
            <p class="order-history-empty"><%= t("auth.no_orders") %></p>
          <% end %>
        </div>
      </div>
    </div>
  </section>
</main>
